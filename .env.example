# PostgreSQL接続文字列。docker-compose.yml の設定に合わせたデフォルト値。
DATABASE_URL="postgresql://hagukuma:hagukuma@localhost:5432/hagukuma_crm"

# スタッフログイン(Auth.js)のセッション署名用シークレット。
# 各環境で個別に生成してください: openssl rand -base64 32
AUTH_SECRET=""

# タイムゾーン。来店日時をJSTで正しく扱うために必須。
# 変数名が "TZ" ではなく "APP_TZ" なのは、Vercelで "TZ" が予約済みで使えないため
# (instrumentation.ts が起動時に process.env.TZ へ反映します)。
APP_TZ="Asia/Tokyo"

# 気づきチェック(AI気づき)を生成するための Anthropic API キー。
# 未設定の場合、AI気づきはスキップされ事務チェック(記入漏れ)のみ実行されます。
ANTHROPIC_API_KEY=""

# LINE公式アカウント Messaging API のチャネルアクセストークン(リマインド送信・友だち一覧取得用)
LINE_CHANNEL_ACCESS_TOKEN=""

# LINE Webhook(/api/line/webhook)の署名検証用チャネルシークレット。
# LINE_CHANNEL_ACCESS_TOKENとは別の値(LINE Developersコンソールの同じチャネル設定画面で確認可能)。
LINE_CHANNEL_SECRET=""

# LINE事前問診フォーム(/intake)用のLIFF設定。
# LINEの仕様変更によりMessaging APIチャネルに直接LIFFは追加できないため、同じプロバイダー配下に
# LIFF専用のLINEログインチャネルを新規作成し、そちらの「LIFF」タブから追加する(別プロバイダーで
# 作成するとLINEのユーザーIDがMessaging APIチャネル側と一致せず、自動突合が機能しなくなるので注意)。
# NEXT_PUBLIC_LIFF_ID: LIFFアプリ作成時に発行されるID(ブラウザ側のLIFF初期化に使う。公開される値)
# LIFF_CHANNEL_ID: LIFFを作成したLINEログインチャネル自身のチャネルID(数字のみ。Messaging APIチャネルの
#                  IDではない)。LIFFのIDトークンをサーバー側で検証する際のaud照合に使う
NEXT_PUBLIC_LIFF_ID=""
LIFF_CHANNEL_ID=""

# 姿勢写真・インボディ結果の画像を保存するSupabase Storage(DATABASE_URLと同じSupabaseプロジェクト)。
# Project Settings → API から取得。SUPABASE_SERVICE_ROLE_KEYは公開してはいけない値(Storageの非公開バケットへの
# フルアクセス権限を持つ)。ローカル開発でも本番同様Supabaseプロジェクトの値を使う(ローカル専用の代替は用意していない)。
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# 画像本体はVercelのサーバー関数を経由せず、ブラウザからSupabase Storageへ直接アップロードする
# (Vercel側のリクエストボディ上限・約4.5MBを回避するため。docs/client-photos-upload-fix-v2.md)。
# そのためブラウザ側でもSupabaseプロジェクトURL・anonキーが必要。NEXT_PUBLIC_SUPABASE_URLの値は
# SUPABASE_URLと同じでよい。anonキー(service_roleキーとは別物)は公開して問題ない値。
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- 以下は将来の連携用(現時点では未確認/未接続。詳細は README を参照) ---


# ホットペッパービューティー予約データの取り込み方式が確定したら追記
# HOTPEPPER_IMPORT_METHOD=""
