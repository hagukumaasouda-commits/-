# PostgreSQL接続文字列。docker-compose.yml の設定に合わせたデフォルト値。
DATABASE_URL="postgresql://hagukuma:hagukuma@localhost:5432/hagukuma_crm"

# スタッフログイン(Auth.js)のセッション署名用シークレット。
# 各環境で個別に生成してください: openssl rand -base64 32
AUTH_SECRET=""

# タイムゾーン。来店日時をJSTで正しく扱うために必須。
# 変数名が "TZ" ではなく "APP_TZ" なのは、Vercelで "TZ" が予約済みで使えないため
# (instrumentation.ts が起動時に process.env.TZ へ反映します)。
APP_TZ="Asia/Tokyo"

# 気づきチェック(AI気づき)を生成するための Anthropic API キー。
# 未設定の場合、AI気づきはスキップされ事務チェック(記入漏れ)のみ実行されます。
ANTHROPIC_API_KEY=""

# --- 以下は将来の連携用(現時点では未確認/未接続。詳細は README を参照) ---

# LINE公式アカウント Messaging API のチャネルアクセストークン(自動リマインド送信用)
LINE_CHANNEL_ACCESS_TOKEN=""

# ホットペッパービューティー予約データの取り込み方式が確定したら追記
# HOTPEPPER_IMPORT_METHOD=""
