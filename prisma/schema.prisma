// はぐくま CRM・電子カルテ統合 データモデル
// 設計方針: 来院(Visit)を起点に カルテ / プリカ / 予約 / 気づき が client にぶら下がる。
// カルテの可変項目は JSON で柔軟に持ち、集計・チェックに使う項目だけ実カラム/タグ配列に切り出す。

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// マスタ
// ---------------------------------------------------------------------------

model Staff {
  id           String    @id @default(cuid())
  name         String
  username     String?   @unique
  passwordHash String?
  role         StaffRole @default(STAFF)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())

  primaryClients      Client[]             @relation("PrimaryStaff")
  clientAssignments   ClientStaff[]
  visits              Visit[]
  staffMindsetChecks  StaffMindsetCheck[]
  awarenessDialogues  AwarenessDialogue[]
  productSales        ProductSale[]
  prepaidTransactions PrepaidTransaction[]

  departuresConfirmed     DepartureRecord[]     @relation("DepartureConfirmedBy")
  followupsContacted      FollowupCheckpoint[]  @relation("FollowupContactedBy")
  reassignmentsAsCurrent  ReassignmentRequest[] @relation("ReassignmentCurrentStaff")
  reassignmentsRequested  ReassignmentRequest[] @relation("ReassignmentRequestedBy")
  reassignmentsAsNewStaff ReassignmentRequest[] @relation("ReassignmentNewStaff")
}

enum StaffRole {
  STAFF
  DIRECTOR // 院長
}

model AcquisitionChannel {
  id      String   @id @default(cuid())
  name    String   @unique // 院の看板 / ホットペッパービューティー / ホームページ / インスタグラム・SNS / ご紹介 / その他
  clients Client[]
}

// ---------------------------------------------------------------------------
// 顧客
// ---------------------------------------------------------------------------

model Client {
  id                 String    @id @default(cuid())
  name               String
  kana               String?
  dob                DateTime?
  gender             String?
  phone              String?
  postalCode         String?
  address            String?
  occupation         String?
  lifestyleTags      Json? // 睡眠時間・飲水量・食事内容などの初回フォーム項目
  lineUserId         String?   @unique // LINE公式アカウントの友だち追加で取得するID(リマインド送信先)
  externalCustomerNo String?   @unique // サロンボードの「お客様番号」。顧客管理シートのID列と同一体系で、CSV取り込みの突合キーになる

  acquisitionChannelId String?
  acquisitionChannel   AcquisitionChannel? @relation(fields: [acquisitionChannelId], references: [id])

  referredById String?
  referredBy   Client?  @relation("Referral", fields: [referredById], references: [id])
  referrals    Client[] @relation("Referral")

  primaryStaffId   String?
  primaryStaff     Staff?        @relation("PrimaryStaff", fields: [primaryStaffId], references: [id])
  staffAssignments ClientStaff[]

  firstVisitDate    DateTime?
  isActive          Boolean   @default(true) // 離脱バッチが更新するフラグ
  initialVisitCount Int       @default(0) // 登録時点までの来院回数(既存の実績)。表示上の来院回数 = これ + このアプリで記録したVisit件数
  createdAt         DateTime  @default(now())

  medicalHistory String? // 既往(自由記述)
  familyData     String? // 家族データ(自由記述)
  personalData   String? // 個人データ(自由記述)

  rank ClientRank? // ランク。顧客登録・編集画面、および来院のたびに来院記録フォームからも更新できる(現状値のみ保持、履歴は持たない)

  visits               Visit[]
  treatmentCourses     TreatmentCourse[]
  prepaidCard          PrepaidCard?
  reservations         Reservation[]
  statusSnapshots      ClientStatusSnapshot[]
  productSales         ProductSale[]
  departureRecords     DepartureRecord[]
  reassignmentRequests ReassignmentRequest[]

  @@index([acquisitionChannelId])
  @@index([primaryStaffId])
  @@index([firstVisitDate])
}

enum ClientRank {
  AS
  A
  B
  C1
  C2
  C3
}

// 複数担当(祥平, 由衣 など)を許容するための中間テーブル。primaryStaffId は代表担当。
model ClientStaff {
  clientId String
  staffId  String
  client   Client @relation(fields: [clientId], references: [id])
  staff    Staff  @relation(fields: [staffId], references: [id])

  @@id([clientId, staffId])
}

// ---------------------------------------------------------------------------
// 来院・カルテ
// ---------------------------------------------------------------------------

model Visit {
  id       String           @id @default(cuid())
  clientId String
  client   Client           @relation(fields: [clientId], references: [id])
  staffId  String
  staff    Staff            @relation(fields: [staffId], references: [id])
  courseId String?
  course   TreatmentCourse? @relation(fields: [courseId], references: [id])

  visitDate DateTime
  visitNo   Int // その顧客にとって何回目の来院か(作成時に算出)
  menu      String?

  createdAt DateTime @default(now())

  chartRecord     ChartRecord?
  awarenessChecks AwarenessCheck[]
  mindsetChecks   StaffMindsetCheck[]
  prepaidTxns     PrepaidTransaction[]

  @@unique([clientId, visitNo])
  @@index([clientId, visitDate])
}

model ChartRecord {
  id      String @id @default(cuid())
  visitId String @unique
  visit   Visit  @relation(fields: [visitId], references: [id])

  chiefComplaintTags String[] // 肩こり / 腰痛 / 自律神経症状 など(来院理由分布に使用)
  bodyPartTags       String[] // 頭蓋 / 内臓 / 上肢 / 下肢 / 脊椎 / 体幹(施術部位分布に使用)

  exam            Json? // 可動域・脊椎状態・重心軸などの検査値
  treatmentDetail Json? // 部位×体位×コメントの施術詳細

  evaluation      String? // 何が起きているか
  changeFromLast  String? // 前回からの変化
  reevaluation    String? // 何が変わったか(再評価)
  meaningConveyed String? // 患者さんへどう伝えたか
  clientVoice     String? // お客様の声(自己認識)
  nextCheck       String? // 次回確認
  nextRequired    String? // 次回必須

  requiredFields Json? // 必須項目チェックリストの状態(未/完) -> 事務チェックが参照

  requiredVisitInterval VisitInterval? // 必要来院ペース。離脱候補判定に、その顧客の直近の値を使う(未記録なら42日固定にフォールバック)

  lifestyleSupportStatus Json? // 生活習慣サポート実施状況(てる1〜Bトレ等、社内略称キーの済/未マップ。lib/tags.ts の LIFESTYLE_SUPPORT_ITEMS)
  healthPracticeNote     String? // 健康実践状況(自由記述。来院ごとに記録し、タイムラインで時系列に蓄積する)

  healthHappinessScore HealthHappinessScore? // 回復度(健康度幸福度)。任意項目、最新値を顧客詳細ページに表示

  testimonialObtained     Boolean   @default(false) // 口コミを取得したか
  testimonialObtainedDate DateTime? // 取得日(任意)
  referralGiven           Boolean   @default(false) // 紹介をしてくれたか
  referralCount           Int? // 紹介人数(任意。未入力時はreferralGiven=trueなら1として扱う)

  menuPlan            MenuPlan? // 本日のメニュー(プラン)。lib/tags.ts の TREATMENT_MENU と対応
  treatmentModalities Json? // 物療チェック(コアレ10/コアレ20/ブースター/セラゼム/鍼/灸の済/未マップ。生活習慣サポートとは別概念)

  createdAt DateTime @default(now())
}

enum MenuPlan {
  BASIC_CARE // ベーシックケア
  REPAIRNESS_PLAN // リペアネスプラン
  CONDITIONING_PLAN // コンディショニングプラン
  WELLNESS_PLAN // ウェルネスプラン
}

enum VisitInterval {
  TWICE_OR_THRICE_WEEKLY // 週2,3回 = 3日
  WEEK1 // 1週間 = 7日
  DAY10 // 10日 = 10日
  WEEK2 // 2週間 = 14日
  WEEK3 // 3週間 = 21日
  WEEK4 // 4週間 = 28日
  MONTH2 // 2か月 = 60日
  MONTH3 // 3か月 = 90日
}

enum HealthHappinessScore {
  ABOVE_80 // 80%以上
  PCT_70 // 70%
  PCT_60 // 60%
  PCT_55 // 55%
  PCT_50 // 50%
  PCT_40 // 40%
  BELOW_40 // 40%以下
}

// ---------------------------------------------------------------------------
// プラン・プリカ
// ---------------------------------------------------------------------------

model TreatmentCourse {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  courseNo         Int // 1クール, 2クール ...
  planType         String // 都度 / プ1万 / プ2万 / プ3万 / 会員 / お試し / 自賠 等
  plannedSessions  Int?
  durationProposal Json? // 1.5ヶ月40% / 2ヶ月55% / 3ヶ月50% などの継続提案
  goal             String? // 解決したいこと(顕在・深層ニーズ)

  startDate DateTime?
  endDate   DateTime?

  visits Visit[]
}

model PrepaidCard {
  id       String @id @default(cuid())
  clientId String @unique
  client   Client @relation(fields: [clientId], references: [id])

  planType String?
  openedAt DateTime  @default(now())
  closedAt DateTime?

  transactions PrepaidTransaction[]
}

model PrepaidTransaction {
  id     String      @id @default(cuid())
  cardId String
  card   PrepaidCard @relation(fields: [cardId], references: [id])

  txType       PrepaidTxType
  amount       Int // charge は正, use は負で記録
  balanceAfter Int? // 計算結果のスナップショット(表示高速化用。真実はSUMで再計算可能)
  txDate       DateTime      @default(now())

  visitId String?
  visit   Visit?  @relation(fields: [visitId], references: [id])

  staffId String? // 記録した担当スタッフ(手入力の台帳運用のため。仕様書 v2 3.1)
  staff   Staff?  @relation(fields: [staffId], references: [id])

  note String?

  @@index([cardId, txDate])
}

enum PrepaidTxType {
  CHARGE
  USE
  ADJUST
}

// ---------------------------------------------------------------------------
// 予約
// ---------------------------------------------------------------------------

model Reservation {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  source         ReservationSource @default(MANUAL)
  reservedAt     DateTime
  status         ReservationStatus @default(CONFIRMED)
  reminderSentAt DateTime?
  syncedAt       DateTime?

  externalId      String? @unique // サロンボードCSVの「予約番号」。再取り込み時の重複防止キー
  sourceStaffName String? // CSVの「スタッフ名」列をそのまま保持(FK突合はしない参考情報)

  createdAt DateTime @default(now())

  @@index([clientId, reservedAt])
}

enum ReservationSource {
  HOTPEPPER
  LINE
  PHONE
  MANUAL
}

enum ReservationStatus {
  CONFIRMED
  CANCELLED
  CHANGED
  COMPLETED
}

// ---------------------------------------------------------------------------
// 気づきチェック(事務チェック / AI気づき)と対話ログ
// ---------------------------------------------------------------------------

model AwarenessCheck {
  id      String @id @default(cuid())
  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id])

  checkType CheckType // OFFICE(ルールベース記入漏れ) / AI_INSIGHT(関わりの質・離脱兆候)
  category  String // 記入漏れ / 頻度と関わりのギャップ / 来店間隔の変化 / 残高消化と来店の乖離 / 施術内容の変化 等
  message   String // AIや事務チェックが提示する気づき文(断定ではなく問いかけ調)
  severity  Severity    @default(INFO)
  status    CheckStatus @default(OPEN)

  createdAt DateTime @default(now())

  dialogue AwarenessDialogue[]

  @@index([visitId])
  @@index([status])
}

enum CheckType {
  OFFICE
  AI_INSIGHT
}

enum Severity {
  INFO
  NOTICE
  IMPORTANT
}

enum CheckStatus {
  OPEN
  DISCUSSED
  RESOLVED
}

model AwarenessDialogue {
  id               String         @id @default(cuid())
  awarenessCheckId String
  awarenessCheck   AwarenessCheck @relation(fields: [awarenessCheckId], references: [id])
  authorStaffId    String
  authorStaff      Staff          @relation(fields: [authorStaffId], references: [id])
  comment          String
  createdAt        DateTime       @default(now())
}

// 継続カルテ由来: 施術者マインド・フロントトークの自己点検(監視ではなく振り返り用途)
model StaffMindsetCheck {
  id      String @id @default(cuid())
  visitId String
  visit   Visit  @relation(fields: [visitId], references: [id])
  staffId String
  staff   Staff  @relation(fields: [staffId], references: [id])

  selfCheck Json // { totonoeru: bool, imakoko: bool, hyoukakyoufuNashi: bool, haraOKukuru: bool }
  note      String?

  createdAt DateTime @default(now())
}

// 週次/月次の顧客状態スナップショット(ランク・健康度幸福度などの時系列保持)
model ClientStatusSnapshot {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  snapshotDate DateTime
  rank         String? // AS / A / B / C1 / C2 / C3
  healthScore  Int? // 健康度幸福度(%)
  statusLabel  String? // 継続 / 参加 / 納得 / 理解 / 自己決定 / 安心 / 希望 / 不安 等

  @@index([clientId, snapshotDate])
}

// ---------------------------------------------------------------------------
// 物販(商品販売)
// ---------------------------------------------------------------------------

model Product {
  id           String   @id @default(cuid())
  name         String   @unique
  category     String?
  defaultPrice Int? // 参考価格(円)。購入記録フォームの初期値に使うのみで、記録時に金額は上書き可能
  active       Boolean  @default(true) // 取り扱い終了品を選択肢から外すためのフラグ(削除はしない)
  createdAt    DateTime @default(now())

  sales ProductSale[]
}

enum ProductItemType {
  FULL // 本品
  LOOSE // バラ(サンプル・小分け)
}

enum ProductPurchaseType {
  NEW // 新規
  REPEAT // リピート
}

model ProductSale {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // シート上の顧客名(お客様番号+カナ/漢字)から突合できた場合のみ設定。
  // 突合できなかった場合も rawClientLabel に元の文字列を残し、取り込みを止めない。
  clientId       String?
  client         Client? @relation(fields: [clientId], references: [id])
  rawClientLabel String?

  staffId      String?
  staff        Staff?  @relation(fields: [staffId], references: [id])
  rawStaffName String?

  saleDate         DateTime
  amount           Int // 円。プレゼント品は0
  quantity         Int? // 個数(手入力運用のみ。CSV取り込み分は無し)
  itemType         ProductItemType
  purchaseType     ProductPurchaseType
  isGift           Boolean             @default(false) // 「来店数」欄に「プレゼント」と記載されていた行
  visitCountAtSale Int? // 「来店数(新規のみ)」列の数値(新規客のみ入る)

  // 日付+顧客+商品+担当から生成する再取り込み防止キー(シートに一意なID列が無いため)
  dedupKey   String   @unique
  importedAt DateTime @default(now())

  @@index([saleDate])
  @@index([productId, saleDate])
  @@index([clientId])
  @@index([staffId])
}

// ---------------------------------------------------------------------------
// 離脱フォローアップ・担当変更(仕様書 v2: docs/departure-followup-spec-v2.md)
// ---------------------------------------------------------------------------

model DepartureRecord {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  confirmedById String
  confirmedBy   Staff    @relation("DepartureConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime @default(now()) // フォロースケジュールの起点日

  reason     DepartureReason? // triggeredByCancellation の未確定候補は空欄可
  reasonNote String? // 「その他」選択時の自由記述、補足メモ

  triggeredByCancellation Boolean @default(false) // true: キャンセル後未予約がきっかけ(仕様書 2.5)

  checkpoints FollowupCheckpoint[]

  @@index([clientId])
}

enum DepartureReason {
  GRADUATED // 症状改善による卒業(満足)
  TRIAL_ONLY // お試し利用(元々継続意思なし)
  TEMPORARY_VISITOR // 遠方からの一時利用(帰省・出張等)
  SWITCHED_BRANCH // 砥部店(他店舗)へ変更
  NO_PERCEIVED_EFFECT // 効果を実感できなかった
  LIFE_CHANGE // 体調・環境の変化(妊娠・出産・病気・怪我等)
  STAFF_MINDSET_LACK // こちら側のマインド不足
  OTHER // その他(自由記述)
}

// DepartureRecord 作成時に5件自動生成する(仕様書 2.4)
model FollowupCheckpoint {
  id                String          @id @default(cuid())
  departureRecordId String
  departureRecord   DepartureRecord @relation(fields: [departureRecordId], references: [id])

  stage         CheckpointStage
  scheduledDate DateTime

  status        FollowupStatus    @default(PENDING)
  contactMethod ContactMethod?
  response      FollowupResponse?

  contactedById String?
  contactedBy   Staff?    @relation("FollowupContactedBy", fields: [contactedById], references: [id])
  contactedAt   DateTime?

  note String?

  @@index([departureRecordId])
  @@index([scheduledDate])
}

enum CheckpointStage {
  WEEK3
  WEEK6
  MONTH3
  MONTH6
  YEAR1
}

enum FollowupStatus {
  PENDING // 未対応
  CONTACTED // 連絡済み
}

enum ContactMethod {
  LINE
  PHONE
  LETTER // 手紙・はがき
  IN_PERSON // 対面(来店時)
  OTHER
}

enum FollowupResponse {
  WILLING_TO_CONTINUE // 反応あり(継続の意思)
  NOT_CONTINUING // 反応あり(継続なし)
  NO_RESPONSE // 反応なし
  NOT_DONE // 未実施
}

// 離脱の手前で、担当スタッフとの関係性に課題がある場合に使う相談機能(仕様書 2.6)
model ReassignmentRequest {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  currentStaffId String
  currentStaff   Staff  @relation("ReassignmentCurrentStaff", fields: [currentStaffId], references: [id])

  initiatedBy        ReassignmentInitiator
  requestedByStaffId String? // 気づきチェック起点の場合は空
  requestedByStaff   Staff?                @relation("ReassignmentRequestedBy", fields: [requestedByStaffId], references: [id])

  note String? // 相談メモ

  status ReassignmentStatus @default(IN_DISCUSSION)

  newStaffId   String? // 変更確定時の新担当
  newStaff     Staff?  @relation("ReassignmentNewStaff", fields: [newStaffId], references: [id])
  handoverNote String? // 引き継ぎメモ(何を伝えたか・注意点)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([clientId])
  @@index([status])
}

enum ReassignmentInitiator {
  STAFF_SELF // スタッフ本人
  DIRECTOR // 院長
  AWARENESS_CHECK // 気づきチェック(自動検知)
}

enum ReassignmentStatus {
  IN_DISCUSSION // 相談中
  CONFIRMED // 変更確定
  DECLINED // 見送り
}
